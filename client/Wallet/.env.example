TOKEN_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=https://your-vercel-app.vercel.app
MONGODB_URI=mongodb://127.0.0.1:27017/nexa_wallet
MONGODB_DB=nexa_wallet
MAX_BODY_BYTES=1048576

